    {
      "parameters": {
        "sendTo": "security@example.com",
        "subject": "=[{{ $json.risk_level }}] Cybersecurity Alert - {{ $json.risk_score }}/100",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:680px;margin:0 auto\">\n  <div style=\"background:#DC2626;padding:16px 24px;border-radius:8px 8px 0 0\">\n    <h2 style=\"color:#fff;margin:0\">Cybersecurity Threat Detected</h2>\n  </div>\n  <div style=\"border:1px solid #e5e7eb;border-top:none;padding:24px;border-radius:0 0 8px 8px\">\n    <table style=\"width:100%;border-collapse:collapse;margin-bottom:20px\">\n      <tr><td style=\"padding:10px;font-weight:bold\">Risk Score</td><td style=\"padding:10px\"><b>{{ $json.risk_score }}/100 — {{ $json.risk_level }}</b></td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Classification</td><td style=\"padding:10px\">{{ $json.classification }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Input Type</td><td style=\"padding:10px\">{{ $json.input_type }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Content</td><td style=\"padding:10px;word-break:break-word\">{{ $json.content }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Source</td><td style=\"padding:10px\">{{ $json.source }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">Timestamp</td><td style=\"padding:10px\">{{ $json.timestamp }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">AI Confidence</td><td style=\"padding:10px\">{{ $json.confidence }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:bold\">VirusTotal</td><td style=\"padding:10px\">{{ $json.vt_malicious }} malicious / {{ $json.vt_suspicious }} suspicious</td></tr>\n    </table>\n    <div style=\"background:#FEF2F2;border-left:4px solid #DC2626;padding:12px 16px;margin-bottom:16px\">\n      <b>Threat Intent:</b><br>{{ $json.intent }}\n    </div>\n    <div style=\"background:#f9fafb;padding:12px 16px;border-radius:4px;margin-bottom:16px\">\n      <b>Phishing Indicators:</b><br>{{ JSON.stringify($json.phishing_indicators) }}\n    </div>\n    <div style=\"background:#f9fafb;padding:12px 16px;border-radius:4px;margin-bottom:16px\">\n      <b>AI Reasoning:</b><br>{{ $json.reasoning }}\n    </div>\n    <div style=\"background:#EFF6FF;border-left:4px solid #2563EB;padding:12px 16px\">\n      <b>Full Threat Report:</b><br><br>{{ $json.final_report }}\n    </div>\n    <hr style=\"margin:20px 0;border:none;border-top:1px solid #e5e7eb\">\n    <p style=\"color:#6b7280;font-size:12px;margin:0\">\n      Automatically generated by AI Cyber Security Co-Pilot.\n    </p>\n  </div>\n</div>",
