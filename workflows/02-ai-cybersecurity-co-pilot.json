        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You generate concise professional cybersecurity incident reports from supplied evidence. Do not invent evidence.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate a professional cybersecurity threat report:\\n\\nINPUT TYPE: {{ $json.input_type }}\\nCONTENT: {{ $json.content }}\\nSOURCE: {{ $json.source }}\\nTIMESTAMP: {{ $json.timestamp }}\\nRISK SCORE: {{ $json.risk_score }}/100\\nRISK LEVEL: {{ $json.risk_level }}\\nCLASSIFICATION: {{ $json.classification }}\\nPHISHING INDICATORS: {{ JSON.stringify($json.phishing_indicators) }}\\nINTENT: {{ $json.intent }}\\nVT MALICIOUS: {{ $json.vt_malicious }}\\nVT SUSPICIOUS: {{ $json.vt_suspicious }}\\nCONFIDENCE: {{ $json.confidence }}\\n\\nFormat the report exactly like this:\\n\\nTHREAT REPORT\\n====================\\nTime: [timestamp]\\nSource: [source]\\nRisk Score: [score]/100 — [level]\\n\\nTHREAT SUMMARY:\\n[2-3 sentence summary]\\n\\nINDICATORS OF COMPROMISE:\\n[bullet list of phishing indicators]\\n\\nEVIDENCE:\\n• VirusTotal: [malicious] malicious, [suspicious] suspicious engines\\n• AI Confidence: [confidence as percentage]%\\n• Intent: [intent]\\n\\nRECOMMENDED ACTIONS:\\n1. [action based on risk level]\\n2. [action]\\n3. [action]\\n\\nKeep it professional and concise.\"\n    }\n  ],\n  \"temperature\": 0.1\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -608,
        -320
      ],
      "id": "28c6735c-4160-443a-9fc4-f003dc04b9e0",
      "name": "Report Generator"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst reportText = response?.choices?.[0]?.message?.content || \"No report generated.\";\nconst prevData = $('Risk Score').first().json;\n\nreturn [{\n  json: {\n    ...prevData,\n    final_report: reportText\n  }\n}];"
      },
