      "name": "Wait"
    },
    {
      "parameters": {
        "jsCode": "const vtData = $input.first().json;\nconst stats = vtData?.data?.attributes?.stats || {};\nconst prevData = $('Data Normalize').first().json;\n\nreturn [{\n  json: {\n    input_type: prevData.input_type,\n    content: prevData.content,\n    source: prevData.source,\n    timestamp: prevData.timestamp,\n    vt_malicious: stats.malicious || 0,\n    vt_suspicious: stats.suspicious || 0,\n    vt_harmless: stats.harmless || 0,\n    vt_undetected: stats.undetected || 0,\n    vt_raw: JSON.stringify(stats)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1600,
        -176
      ],
      "id": "c3318d89-34c5-4642-9c4b-82e22a8c9d2f",
      "name": "VT Data Extract"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a cybersecurity analyst. Analyze the provided threat evidence conservatively. Do not claim certainty beyond the evidence.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this threat:\\n\\nTYPE: {{ $json.input_type }}\\nCONTENT: {{ $json.content }}\\nVT Malicious: {{ $json.vt_malicious }}\\nVT Suspicious: {{ $json.vt_suspicious }}\\n\\nReturn ONLY JSON:\\n{\\n  \\\"classification\\\": \\\"Safe | Suspicious | High Risk\\\",\\n  \\\"phishing_indicators\\\": [],\\n  \\\"intent\\\": \\\"one sentence\\\",\\n  \\\"confidence\\\": 0.0,\\n  \\\"reasoning\\\": \\\"brief\\\"\\n}\"\n    }\n  ],\n  \"temperature\": 0.1\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -1408,
        -176
      ],
      "id": "15403437-c929-426d-8362-5705820cddb5",
      "name": "Groq API"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst rawText = response?.choices?.[0]?.message?.content || \"\";\n\nlet aiResult;\n\ntry {\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (!jsonMatch) throw new Error(\"No JSON object found\");\n  aiResult = JSON.parse(jsonMatch[0]);\n} catch (e) {\n  aiResult = {\n    classification: \"Suspicious\",\n    phishing_indicators: [\"AI response could not be parsed\"],\n    intent: \"Could not determine intent reliably.\",\n    confidence: 0.5,\n    reasoning: rawText || \"No usable AI response received.\"\n  };\n}\n\nconst prevData = $('Data Normalize').first().json;\nconst vtData = $('VT Data Extract').first().json;\n\nreturn [{\n  json: {\n    ...prevData,\n    vt_malicious: vtData.vt_malicious,\n    vt_suspicious: vtData.vt_suspicious,\n    vt_harmless: vtData.vt_harmless,\n    vt_undetected: vtData.vt_undetected,\n    ...aiResult\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        -160
      ],
      "id": "5f054604-70bc-4d05-ba80-65658c12a726",
      "name": "AI Analysis"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nlet score = 0;\n\nscore += Math.min((d.vt_malicious || 0) * 3, 35);\nscore += Math.min((d.vt_suspicious || 0) * 2, 10);\n\nscore += d.classification === \"High Risk\" ? 30\n       : d.classification === \"Suspicious\" ? 15 : 0;\n\nscore += Math.round((d.confidence || 0) * 15);\n\nconst indicators = Array.isArray(d.phishing_indicators)\n  ? d.phishing_indicators\n  : [];\n\nscore += Math.min(indicators.length * 3, 10);\nscore = Math.min(score, 100);\n\nconst level = score >= 70 ? \"CRITICAL\"\n            : score >= 40 ? \"HIGH\"\n            : score >= 20 ? \"MEDIUM\"\n            : \"LOW\";\n\nreturn [{\n  json: {\n    ...d,\n    risk_score: score,\n    risk_level: level\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
