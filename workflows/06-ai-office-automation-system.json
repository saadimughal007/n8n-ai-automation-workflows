      "parameters": {
        "jsCode": "try {\n  const item = $input.first().json;\n  const raw = item.output?.[0]?.content?.[0]?.text || item.message?.content || item.text || \"\";\n  const cleaned = raw.replace(/```(?:json)?/g, '').trim();\n  const ai = JSON.parse(cleaned);\n  return [{\n    json: {\n      ...item,\n      intent: ai.intent || \"unknown\",\n      reply: ai.reply || \"\",\n      action: ai.action || \"RESPOND\",\n      priority: ai.priority || \"MEDIUM\"\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      error: true,\n      message: error.message,\n      raw: JSON.stringify($input.first().json, null, 2)\n    }\n  }];\n}"
      },
