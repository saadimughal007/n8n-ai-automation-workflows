    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n  const sentiment = data.sentimentAnalysis?.category || data.category || 'Neutral';\n  const department = data.department_category || 'General';\n  const ticketText = data.chatInput || '';\n\n  let priorityScore = 0;\n  const text = ticketText.toLowerCase();\n\n  if (sentiment === 'Urgent') priorityScore += 45;\n  else if (sentiment === 'Negative') priorityScore += 30;\n  else if (sentiment === 'Neutral') priorityScore += 10;\n  else if (sentiment === 'Positive') priorityScore += 5;\n\n  if (department === 'Billing') priorityScore += 20;\n  if (department === 'Technical') priorityScore += 15;\n  if (department === 'Sales') priorityScore += 10;\n  if (department === 'General') priorityScore += 5;\n\n  const riskKeywords = ['refund', 'charged twice', 'double charge', 'cancel', 'angry', 'furious', 'immediately', 'not working', 'cannot login', 'urgent', 'complaint'];\n  const matchedKeywords = riskKeywords.filter(keyword => text.includes(keyword));\n  priorityScore += matchedKeywords.length * 10;\n  if (priorityScore > 100) priorityScore = 100;\n\n  let priority = 'LOW';\n  if (priorityScore >= 80) priority = 'CRITICAL';\n  else if (priorityScore >= 60) priority = 'HIGH';\n  else if (priorityScore >= 31) priority = 'MEDIUM';\n\n  const requiresHumanReview = priority === 'HIGH' || priority === 'CRITICAL' || sentiment === 'Urgent' || sentiment === 'Negative';\n\n  return {\n    json: {\n      ...data,\n      final_sentiment: sentiment,\n      final_department: department,\n      ticket_text: ticketText,\n      priority_score: priorityScore,\n      priority,\n      matched_risk_keywords: matchedKeywords,\n      requires_human_review: requiresHumanReview,\n      workflow_status: requiresHumanReview ? 'WAITING_HUMAN_REVIEW' : 'AI_AUTO_APPROVED'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        16
      ],
      "id": "e35ff8bb-e1ab-4522-ba88-6bf5a17ddde9",
      "name": "Calculate Priority & Review Requirement"
    },
